# 由 istudyctl bootstrap 產生 /opt/istudy/.env（權限 640，root:10001；Agent 備份時需要讀取），不要手動複製這個檔案到正式環境。
DB_PASSWORD=請由-bootstrap-產生
ISTUDY_PORT=4080
ISTUDY_VERSION=1.0.0-dev.62
RENDER_GID=109
MEDIA_ROOT=/Media
ISTUDY_ENCODER=auto
# 主機 PostgreSQL 18 的 Unix socket 目錄與連接埠（bootstrap 依 unix_socket_directories／port 寫入）
PG_SOCKET_DIR=/var/run/postgresql
DB_PORT=5432
